{
  "kind": "collectionType",
  "collectionName": "commandes",
  "info": {
    "singularName": "commande",
    "pluralName": "commandes",
    "displayName": "Commande",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "Nom": {
      "type": "string",
      "required": true
    },
    "Email": {
      "type": "email",
      "required": true
    },
    "Telephone": {
      "type": "string",
      "required": true
    },
    "mode_livraison": {
      "type": "enumeration",
      "enum": [
        "livraison_domicile",
        "retrait_gratuit"
      ],
      "default": "livraison_domicile"
    },
    "pays": {
      "type": "string"
    },
    "code_postal": {
      "type": "string"
    },
    "ville": {
      "type": "string"
    },
    "rue": {
      "type": "string"
    },
    "adresse": {
      "type": "text"
    },
    "articles": {
      "type": "customField",
      "customField": "global::articles",
      "required": true
    },
    "total": {
      "type": "decimal"
    },
    "statut": {
      "type": "customField",
      "customField": "global::statut"
    },
    "notes": {
      "type": "text"
    },
    "email_sent": {
      "type": "customField",
      "customField": "global::email-sent"
    },
    "methode_paiement": {
      "type": "enumeration",
      "enum": [
        "virement",
        "carte"
      ],
      "default": "virement"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "stripe_payment_intent": {
      "type": "string"
    }
  }
}
